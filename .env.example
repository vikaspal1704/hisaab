# From Supabase: Project Settings -> API. Both are safe to ship to browsers;
# Row Level Security protects the data.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Set to "true" only after configuring an SMS provider in Supabase Auth.
VITE_ENABLE_PHONE_OTP=false

# Optional: Web Push public key (npx web-push generate-vapid-keys). Leave empty to hide notifications.
VITE_VAPID_PUBLIC_KEY=
